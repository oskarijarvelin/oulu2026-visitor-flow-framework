---
import Bars from '../charts/bars.ts';
import Lines from '../charts/lines.ts';
import Scatter from '../charts/scatter.ts';
import Callout from '../components/Callout.astro';
import TableScroll from '../components/TableScroll.astro';
import Figure from '../components/Figure.astro';
import Layout from '../components/Layout.astro';
import dailyData from '../data/daily.json';
import metaData from '../data/meta.json';
import { SERIES, WEATHER_GROUP_COLOR } from '../lib/colors.ts';
import { formatDate, formatDecimal, formatInt } from '../lib/format.ts';
import { meanOf, medianOf, toDailyRows } from '../lib/series.ts';
import { RAINY_DAY_MM, WEATHER_GROUP_LABEL, WEATHER_GROUP_ORDER } from '../lib/weather.ts';
import type { DailyData, DailyRow, Meta, WeatherGroup } from '../lib/types.ts';

const site = metaData as Meta;
const daily = dailyData as unknown as DailyData;

interface VenueWeather {
  name: string;
  rows: DailyRow[];
  rainy: DailyRow[];
  dry: DailyRow[];
  groups: { group: WeatherGroup; days: number; mean: number; median: number }[];
}

const perVenue: VenueWeather[] = site.venues.map((venue) => {
  const rows = toDailyRows(daily.venues[String(venue.venue_id)], daily.weather_groups).filter(
    (row) => row.is_reporting && row.temp_mean !== undefined,
  );
  const rainy = rows.filter((row) => (row.precip_sum ?? 0) >= RAINY_DAY_MM);
  const dry = rows.filter((row) => (row.precip_sum ?? 0) < RAINY_DAY_MM);
  const groups = WEATHER_GROUP_ORDER.map((group) => {
    const subset = rows.filter((row) => row.weather_group === group);
    return {
      group,
      days: subset.length,
      mean: meanOf(subset.map((row) => row.visitors_total)),
      median: medianOf(subset.map((row) => row.visitors_total)),
    };
  }).filter((entry) => entry.days > 0);
  return { name: venue.name, rows, rainy, dry, groups };
});

const scatterPoints = site.venues.flatMap((venue) =>
  toDailyRows(daily.venues[String(venue.venue_id)], daily.weather_groups)
    .filter((row) => row.is_reporting && row.temp_mean !== undefined)
    .map((row) => ({
      date: row.date,
      venue: venue.name,
      temp: row.temp_mean ?? 0,
      visitors: row.visitors_total,
      precip: row.precip_sum ?? 0,
      group: row.weather_group ?? ('other' as WeatherGroup),
    })),
);

const rainyBars = perVenue.flatMap((entry) => [
  {
    label: `${entry.name}, poutaiset`,
    value: Math.round(meanOf(entry.dry.map((row) => row.visitors_total)) * 10) / 10,
    n: entry.dry.length,
    color: SERIES.history,
    note: `Sade alle ${formatDecimal(RAINY_DAY_MM)} mm`,
  },
  {
    label: `${entry.name}, sateiset`,
    value: Math.round(meanOf(entry.rainy.map((row) => row.visitors_total)) * 10) / 10,
    n: entry.rainy.length,
    color: SERIES.light,
    note: `Sade vähintään ${formatDecimal(RAINY_DAY_MM)} mm`,
  },
]);

const groupBars = perVenue.flatMap((entry) =>
  entry.groups.map((group) => ({
    label: `${entry.name}: ${WEATHER_GROUP_LABEL[group.group]}`,
    value: Math.round(group.mean * 10) / 10,
    n: group.days,
    color: WEATHER_GROUP_COLOR[group.group] ?? SERIES.history,
  })),
);

const trafficRows = daily.traffic;
---

<Layout
  title="Sää"
  heading="Sää ja kävijämäärät"
  description="Sään ja kävijämäärien yhteisvaihtelu: hajontakuvio, sateiset ja poutaiset päivät sekä säätilaluokittainen jakauma."
  lead="Sää kulkee samaa tahtia vuodenajan, ohjelmiston ja koulujen lomien kanssa. Kaikki tällä sivulla esitetty on yhteisvaihtelua, ei syysuhdetta. Neljän ja puolen kuukauden aineistosta ei voi erottaa säätä vuodenajasta."
>
  <div class="mt-6 space-y-6">
    <Figure
      title="Lämpötila ja kävijätapahtumat"
      description="Yksi piste on yksi vuorokausi. Vaaka-akselilla vuorokauden keskilämpötila, pystyakselilla kävijätapahtumat. Väri ja symboli kertovat säätilaluokan, pisteen koko sademäärän."
      footnote="Katkoviiva on pienimmän neliösumman suora. Se kuvaa kahden suureen yhteisvaihtelua eikä sano mitään syysuhteesta."
    >
      <Scatter
        client:visible
        ariaLabel="Hajontakuvio: vuorokauden keskilämpötila vaaka-akselilla ja kävijätapahtumat pystyakselilla, väri säätilaluokan mukaan."
        points={scatterPoints}
        placeholderHeight={320}
      />
      <div slot="alternative">
        <p class="mb-3 text-xs leading-5 text-ink-muted">
          {`Aineistossa on ${formatInt(scatterPoints.length)} vuorokautta molemmilta venueilta yhteensä. Lämpötila-akseli kattaa ${formatDecimal(Math.min(...scatterPoints.map((point) => point.temp)))} ja ${formatDecimal(Math.max(...scatterPoints.map((point) => point.temp)))} celsiusasteen välin. Sadetta oli vähintään ${formatDecimal(RAINY_DAY_MM)} mm ${formatInt(scatterPoints.filter((point) => point.precip >= RAINY_DAY_MM).length)} vuorokautena.`}
        </p>
        <TableScroll label="Kymmenen vilkkainta vuorokautta säätietoineen">
          <table class="data-table">
            <caption>Kymmenen vilkkainta vuorokautta säätietoineen</caption>
          <thead class="is-sticky">
            <tr>
              <th scope="col">Päivä</th>
              <th scope="col">Venue</th>
              <th scope="col" class="num">Kävijätapahtumat</th>
              <th scope="col" class="num">Keskilämpötila</th>
              <th scope="col" class="num">Sade</th>
              <th scope="col">Säätila</th>
            </tr>
          </thead>
          <tbody>
            {
              [...scatterPoints]
                .sort((a, b) => b.visitors - a.visitors)
                .slice(0, 10)
                .map((point) => (
                  <tr>
                    <th scope="row" class="nowrap">{formatDate(point.date)}</th>
                    <td>{point.venue}</td>
                    <td class="num">{formatInt(point.visitors)}</td>
                    <td class="num">{formatDecimal(point.temp)} °C</td>
                    <td class="num">{formatDecimal(point.precip)} mm</td>
                    <td>{WEATHER_GROUP_LABEL[point.group]}</td>
                  </tr>
                ))
            }
          </tbody>
        </table>
        </TableScroll>
      </div>
    </Figure>

    <Figure
      title="Sateiset ja poutaiset vuorokaudet"
      description={`Vuorokauden keskimääräiset kävijätapahtumat sen mukaan satoiko vähintään ${formatDecimal(RAINY_DAY_MM)} mm. Sama kynnys kuin ennustemallin piirteellä is_rainy_day.`}
      footnote="Havaintomäärät ovat pieniä ja jakaumat vinoja, joten ero kahden pylvään välillä ei ole tilastollisesti vahva tulos."
    >
      <Bars
        client:visible
        ariaLabel="Pylväskaavio: keskimääräiset kävijätapahtumat sateisina ja poutaisina vuorokausina venuekohtaisesti."
        data={rainyBars}
        horizontal={true}
        placeholderHeight={220}
      />
      <div slot="alternative">
        <TableScroll label="Sateiset ja poutaiset vuorokaudet" scrollY={false}>
          <table class="data-table">
            <caption>Sateiset ja poutaiset vuorokaudet</caption>
          <thead>
            <tr>
              <th scope="col">Ryhmä</th>
              <th scope="col" class="num">Vuorokausia</th>
              <th scope="col" class="num">Keskiarvo</th>
            </tr>
          </thead>
          <tbody>
            {
              rainyBars.map((bar) => (
                <tr>
                  <th scope="row">{bar.label}</th>
                  <td class="num">{formatInt(bar.n ?? 0)}</td>
                  <td class="num">{formatDecimal(bar.value)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        </TableScroll>
      </div>
    </Figure>

    <Figure
      title="Säätilaluokittainen jakauma"
      description="Vuorokauden keskimääräiset kävijätapahtumat WMO-säätilakoodin ryhmän mukaan. Ryhmittely on sama kuin ennustemallin weather_group -piirteellä."
      footnote="Ryhmien havaintomäärät vaihtelevat paljon. Lumipäiviä on aineistossa vain kourallinen, joten niiden keskiarvo on epävakaa."
    >
      <Bars
        client:visible
        ariaLabel="Pylväskaavio: keskimääräiset kävijätapahtumat säätilaluokan mukaan venuekohtaisesti."
        data={groupBars}
        horizontal={true}
        placeholderHeight={280}
      />
      <div slot="alternative">
        <TableScroll label="Säätilaluokat" scrollY={false}>
          <table class="data-table">
            <caption>Säätilaluokat</caption>
          <thead>
            <tr>
              <th scope="col">Venue ja säätila</th>
              <th scope="col" class="num">Vuorokausia</th>
              <th scope="col" class="num">Keskiarvo</th>
              <th scope="col" class="num">Mediaani</th>
            </tr>
          </thead>
          <tbody>
            {
              perVenue.flatMap((entry) =>
                entry.groups.map((group) => (
                  <tr>
                    <th scope="row">
                      {entry.name}: {WEATHER_GROUP_LABEL[group.group]}
                    </th>
                    <td class="num">{formatInt(group.days)}</td>
                    <td class="num">{formatDecimal(group.mean)}</td>
                    <td class="num">{formatDecimal(group.median)}</td>
                  </tr>
                )),
              )
            }
          </tbody>
        </table>
        </TableScroll>
      </div>
    </Figure>

    {
      site.traffic && trafficRows.length > 0 && (
        <Figure
          title="Kontekstidata: kaupungin liikennelaskuri"
          description={`Oulun liikenteen laskuripiste ${site.traffic.site_name}, jalankulkijat ja pyöräilijät vuorokausittain. Tämä on kaupungin liikennettä, ei kummankaan venuen kävijämäärä.`}
          footnote="Laskuri on yksi mittauspiste Oulussa. Sitä ei yhdistetä venuekohtaiseksi mittariksi eikä se ole venue 2:n kävijädataa. Se on mukana vain taustatietona siitä miten sää näkyy kaupungilla liikkumisessa."
        >
          <Lines
            client:visible
            ariaLabel={`Aikasarja: ${site.traffic.site_name} -laskurin jalankulkijat ja pyöräilijät vuorokausittain.`}
            xType="date"
            unit="ohitusta"
            showPoints={false}
            series={[
              {
                name: 'Jalankulkijat',
                color: SERIES.accent,
                points: trafficRows.map((row) => ({ x: row.date, y: row.pedestrians })),
              },
              {
                name: 'Pyöräilijät',
                color: SERIES.compare,
                dash: '5 4',
                points: trafficRows.map((row) => ({ x: row.date, y: row.cyclists })),
              },
            ]}
            placeholderHeight={240}
          />
          <div slot="alternative">
            <p class="text-xs leading-5 text-ink-muted">
              {`Jaksolla ${formatDate(site.traffic.first_day)} - ${formatDate(site.traffic.last_day)} laskuri kirjasi ${formatInt(site.traffic.pedestrians)} jalankulkijaa ja ${formatInt(site.traffic.cyclists)} pyöräilijää, eli keskimäärin ${formatDecimal(site.traffic.pedestrians / trafficRows.length)} ja ${formatDecimal(site.traffic.cyclists / trafficRows.length)} vuorokaudessa. Pyöräily kasvaa keväällä voimakkaasti, mikä näkyy sarjassa selvemmin kuin missään venuedatassa.`}
            </p>
          </div>
        </Figure>
      )
    }

    <Callout tone="warning" title="Miksi sään vaikutusta ei voi eristää">
      <p>
        Aineisto kattaa tammikuusta toukokuuhun 2026. Sinä aikana lämpötila nousee noin
        kahdestakymmenestä pakkasasteesta kesälämpötiloihin, ja samaan aikaan muuttuu kaikki muukin:
        ohjelmisto, koulujen lomat, valoisuus ja matkailukausi. Malli käyttää säätä piirteenä ja se
        parantaa ennustetta hieman, mutta piirretärkeys osoittaa tuulen nousevan lämpötilan ohi. Se on
        merkki siitä että säämuuttujat toimivat vuodenajan sijaisena, eivät mekanismina.
      </p>
    </Callout>
  </div>
</Layout>
