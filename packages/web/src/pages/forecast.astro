---
import ForecastChart from '../charts/forecastchart.ts';
import Callout from '../components/Callout.astro';
import TableScroll from '../components/TableScroll.astro';
import Figure from '../components/Figure.astro';
import Layout from '../components/Layout.astro';
import StatCard from '../components/StatCard.astro';
import forecastData from '../data/forecast.json';
import metaData from '../data/meta.json';
import qualityData from '../data/quality.json';
import { addDays } from '../lib/dates.ts';
import { formatDate, formatDateWithWeekday, formatDecimal, formatInt, formatUtcAsHelsinki } from '../lib/format.ts';
import { horizonBucketLabel, modelLabel, translateWarnings, weatherSourceLabel } from '../lib/labels.ts';
import { WEATHER_GROUP_LABEL } from '../lib/weather.ts';
import type { ForecastData, Meta, QualityData } from '../lib/types.ts';

const site = metaData as Meta;
const forecast = forecastData as unknown as ForecastData;
const quality = qualityData as unknown as QualityData;

const defaultModel = forecast.default_model;

const panels = site.venues.map((venue) => {
  const key = String(venue.venue_id);
  const venueForecast = forecast.venues[key]!;
  const venueQuality = quality.venues[key]!;

  const models = forecast.models.map((name) => ({
    name,
    label: modelLabel(name),
    mae: `backtest-MAE 1-7 vrk ${formatDecimal(venueQuality.metrics[name]?.['1-7']?.mae ?? 0)}`,
  }));

  const toSeries = (rows: { date?: string; ts?: string; p10: number; p50: number; p90: number; weather_source: string }[]) =>
    rows.map((row) => ({
      t: row.date ?? row.ts ?? '',
      p10: row.p10,
      p50: row.p50,
      p90: row.p90,
      clim: row.weather_source === 'climatology',
    }));

  return {
    venue,
    venueForecast,
    venueQuality,
    models,
    daily: Object.fromEntries(
      Object.entries(venueForecast.daily).map(([model, rows]) => [model, toSeries(rows)]),
    ),
    hourly: Object.fromEntries(
      Object.entries(venueForecast.hourly).map(([model, rows]) => [model, toSeries(rows)]),
    ),
    defaultRows: venueForecast.daily[defaultModel] ?? [],
    climatologyFrom: addDays(venueForecast.origin_date, venueForecast.forecast_weather_days + 1),
  };
});

const warnings = translateWarnings(site.forecast.warnings);

// Sään lähde vaihtuu klimatologiaksi venuekohtaisesti. Käytännössä raja on sama
// molemmilla, mutta teksti lasketaan silti datasta eikä oleteta.
const weatherDays = panels.map((panel) => panel.venueForecast.forecast_weather_days);
const minWeatherDays = Math.min(...weatherDays);
const maxWeatherDays = Math.max(...weatherDays);
const weatherDaysLabel =
  minWeatherDays === maxWeatherDays ? String(minWeatherDays) : `${minWeatherDays}-${maxWeatherDays}`;
---

<Layout
  title="Ennuste"
  heading="Ennuste: 7 vuorokautta tunneittain, 30 vuorokautta päivittäin"
  description="Kävijämäärän ennuste molemmille venueille, epävarmuusväli ja mallien vertailu."
  lead={`Ennuste on ajettu ${formatUtcAsHelsinki(forecast.generated_at)} ja se lähtee vuorokaudesta ${formatDate(site.forecast.origin_date)}, joka on viimeisin havaittu vuorokausi. Oletuksena näkyy ${modelLabel(defaultModel)}, joka on tuotantomalli. Jokainen ennuste esitetään aina epävarmuusvälin kanssa, ei yhtenä lukuna.`}
>
  <div class="mt-6">
    <Callout tone="warning" title="Lue tämä ennen kuin käytät lukuja">
      <ul class="list-disc space-y-1 pl-5">
        {warnings.map((warning) => <li>{warning}</li>)}
        <li>
          Vuorokaudet 1-{weatherDaysLabel} käyttävät sääennustetta. Sen jälkeen sää on
          klimatologiaa eli kymmenen vuoden keskiarvo. Keskiarvosää tuottaa
          keskiarvokävijämäärän, joten horisontin loppupää on systemaattisesti liian tasainen.
          Raja on merkitty jokaiseen kaavioon.
        </li>
        <li>
          Ennustevälit ovat leveitä. Ne tulevat mitatusta backtest-virheestä, eivät mallin omista
          oletuksista, ja ne kertovat rehellisesti mitä neljän ja puolen kuukauden aineistolla voi
          sanoa. Tarkkaan resursointiin ne ovat liian leveät.
        </li>
      </ul>
    </Callout>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      site.venues.map((venue) => (
        <>
          <StatCard
            label={`${venue.name}, seuraavat 7 vrk`}
            value={formatInt(venue.next7?.p50 ?? 0)}
            unit="kävijätapahtumaa"
            note={`Väli ${formatInt(venue.next7?.p10 ?? 0)} - ${formatInt(venue.next7?.p90 ?? 0)}. Summa on vuorokausikohtaisten välien summa, joten se on leveämpi kuin jakson oma väli.`}
          />
          <StatCard
            label={`${venue.name}, vuorokausikeskiarvo`}
            value={formatInt((venue.next7?.p50 ?? 0) / Math.max(1, venue.next7?.days ?? 7))}
            unit="/ vrk"
            note={`Vertailuksi viimeiset 30 havaittua vuorokautta: ${formatInt(venue.last30.mean_daily)} vuorokaudessa.`}
          />
        </>
      ))
    }
  </div>

  <div class="mt-6 space-y-6">
    {
      panels.map(({ venue, venueForecast, venueQuality, models, daily, hourly, defaultRows, climatologyFrom }) => (
        <Figure
          title={`${venue.name}: ennuste`}
          description={`Katkoviiva on mediaaniennuste ja vaalea alue sen p10 - p90 -väli. Mallivalitsin vaihtaa mallia, tarkkuusvalitsin tunti- ja päivätason välillä. Legenda kertoo kummankin mallin backtest-MAE:n lähihorisontilla.`}
          footnote={`Vuorokaudesta ${formatDate(climatologyFrom)} alkaen tausta on vaalean ruskea ja viiva pisteviiva: näiden vuorokausien sää on klimatologiaa, ei sääennustetta. Ero näkyy myös harmaasävyisenä.`}
        >
          <ForecastChart
            client:visible
            ariaLabel={`Ennustekaavio: ${venue.name}, mediaaniennuste ja p10 - p90 -väli 30 vuorokaudelle ja 7 vuorokaudelle tunneittain.`}
            daily={daily}
            hourly={hourly}
            models={models}
            defaultModel={defaultModel}
            forecastWeatherDays={venueForecast.forecast_weather_days}
            originDate={venueForecast.origin_date}
            placeholderHeight={300}
          />

          <div slot="alternative">
            <p class="mb-3 text-xs leading-5 text-ink-muted">
              {`${venue.name}: ${modelLabel(defaultModel)} ennustaa vuorokausille ${formatDate(venueForecast.first_day)} - ${formatDate(venueForecast.last_day)} yhteensä ${formatInt(defaultRows.reduce((acc, row) => acc + row.p50, 0))} kävijätapahtumaa mediaanina. Vuorokaudet 1-${venueForecast.forecast_weather_days} nojaavat sääennusteeseen, vuorokaudet ${venueForecast.forecast_weather_days + 1}-${defaultRows.length} klimatologiaan. Backtest-MAE lähihorisontilla on ${formatDecimal(venueQuality.metrics[defaultModel]?.['1-7']?.mae ?? 0)} kävijätapahtumaa vuorokaudessa.`}
            </p>
            <TableScroll label={`${venue.name}: ${modelLabel(defaultModel)}, 30 vuorokauden ennuste`}>
          <table class="data-table">
            <caption>{`${venue.name}: ${modelLabel(defaultModel)}, 30 vuorokauden ennuste`}</caption>
              <thead class="is-sticky">
                <tr>
                  <th scope="col">Päivä</th>
                  <th scope="col" class="num">Vrk</th>
                  <th scope="col" class="num">p10</th>
                  <th scope="col" class="num">Mediaani</th>
                  <th scope="col" class="num">p90</th>
                  <th scope="col">Sään lähde</th>
                  <th scope="col">Sää ja pyhät</th>
                </tr>
              </thead>
              <tbody>
                {defaultRows.map((row) => (
                  <tr class:list={[row.weather_source === 'climatology' && 'is-climatology']}>
                    <th scope="row" class="nowrap">
                      {formatDateWithWeekday(row.date)}
                    </th>
                    <td class="num muted">{row.horizon_days}</td>
                    <td class="num">{formatInt(row.p10)}</td>
                    <td class="num strong">{formatInt(row.p50)}</td>
                    <td class="num">{formatInt(row.p90)}</td>
                    <td class="muted">{weatherSourceLabel(row.weather_source)}</td>
                    <td class="muted">
                      {[
                        row.temp_mean === undefined ? null : `${formatDecimal(row.temp_mean)} °C`,
                        row.weather_group ? WEATHER_GROUP_LABEL[row.weather_group] : null,
                        row.is_holiday ? (row.holiday_name ?? 'pyhä') : null,
                      ]
                        .filter(Boolean)
                        .join(', ')}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
        </TableScroll>
          </div>
        </Figure>
      ))
    }
  </div>

  <section aria-labelledby="mallivertailu" class="mt-8">
    <h2 id="mallivertailu" class="text-lg font-semibold tracking-tight text-ink">Mallien vertailu</h2>
    <p class="mt-1 max-w-3xl text-sm leading-6 text-ink-muted">
      Sama luku kummallekin mallille horisonttikoreittain. Pienempi MAE on parempi. Tuotantomalli on{' '}
      {modelLabel(defaultModel)}, koska se on ainoa joka voittaa molemmat vertailukohdat molemmilla
      venueilla. Tarkemmat mittarit ja vertailukohdat ovat <a class="underline" href="/quality">laatusivulla</a>.
    </p>
    <div class="mt-4">
      <TableScroll label="Backtest-MAE malleittain ja horisonttikoreittain" scrollY={false}>
          <table class="data-table">
            <caption>Backtest-MAE malleittain ja horisonttikoreittain</caption>
        <thead>
          <tr>
            <th scope="col">Venue</th>
            <th scope="col">Malli</th>
            {
              panels[0]!.venueQuality.horizon_buckets.map((bucket) => (
                <th scope="col" class="num">MAE {horizonBucketLabel(bucket)}</th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            panels.flatMap(({ venue, venueQuality }) =>
              forecast.models.map((model) => (
                <tr>
                  <th scope="row">{venue.name}</th>
                  <td class:list={[model === defaultModel && 'strong']}>
                    {modelLabel(model)}
                    {model === defaultModel ? ' (tuotanto)' : ''}
                  </td>
                  {venueQuality.horizon_buckets.map((bucket) => (
                    <td class="num">
                      {formatDecimal(venueQuality.metrics[model]?.[bucket]?.mae ?? 0)}
                    </td>
                  ))}
                </tr>
              )),
            )
          }
        </tbody>
      </table>
        </TableScroll>
    </div>
  </section>
</Layout>
