---
import Callout from '../components/Callout.astro';
import TableScroll from '../components/TableScroll.astro';
import Figure from '../components/Figure.astro';
import Layout from '../components/Layout.astro';
import StatCard from '../components/StatCard.astro';
import Timeseries from '../charts/timeseries.ts';
import dailyData from '../data/daily.json';
import forecastData from '../data/forecast.json';
import metaData from '../data/meta.json';
import { addDays } from '../lib/dates.ts';
import { toDailyRows } from '../lib/series.ts';
import {
  formatDate,
  formatDateWithWeekday,
  formatInt,
  formatSignedPct,
  visitorEvents,
} from '../lib/format.ts';
import { modelLabel } from '../lib/labels.ts';
import { RAINY_DAY_MM } from '../lib/weather.ts';
import type { DailyData, ForecastData, Meta } from '../lib/types.ts';

const site = metaData as Meta;
const daily = dailyData as unknown as DailyData;
const forecast = forecastData as unknown as ForecastData;

const OVERVIEW_DAYS = 30;
const OVERVIEW_FORECAST_DAYS = 7;
const model = forecast.default_model;

const panels = site.venues.map((venue) => {
  const key = String(venue.venue_id);
  const rows = toDailyRows(daily.venues[key], daily.weather_groups).filter((row) => row.is_reporting);
  const from = addDays(venue.last_day, -(OVERVIEW_DAYS - 1));
  const window = rows.filter((row) => row.date >= from);
  const forecastRows = (forecast.venues[key]?.daily[model] ?? []).filter(
    (row) => row.horizon_days <= OVERVIEW_FORECAST_DAYS,
  );

  return {
    venue,
    window,
    forecastRows,
    history: window.map((row) => ({ t: row.date, v: row.visitors_total })),
    forecastPoints: forecastRows.map((row) => ({
      t: row.date,
      p10: row.p10,
      p50: row.p50,
      p90: row.p90,
      clim: row.weather_source === 'climatology',
    })),
    rain: window.filter((row) => (row.precip_sum ?? 0) >= RAINY_DAY_MM).map((row) => row.date),
    holidays: [
      ...window.filter((row) => row.is_holiday).map((row) => ({ t: row.date, name: row.holiday_name ?? 'Pyhä' })),
      ...forecastRows
        .filter((row) => row.is_holiday)
        .map((row) => ({ t: row.date, name: row.holiday_name ?? 'Pyhä' })),
    ],
  };
});

const totalLast30 = site.venues.reduce((acc, venue) => acc + venue.last30.visitors_total, 0);

// Ennuste lahtee viimeisimmasta havaitusta vuorokaudesta. Jos havainnot ovat jaljessa,
// se on kerrottava: ennuste ei ala tasta paivasta vaan datan lopusta.
const forecastRunDate = site.forecast.generated_at.slice(0, 10);
const observationLagDays = Math.max(
  0,
  ...site.venues.map((venue) => Math.round(
    (Date.parse(`${forecastRunDate}T00:00:00Z`) - Date.parse(`${venue.last_day}T00:00:00Z`)) / 86_400_000,
  )),
);
const observedFrom = site.venues.map((venue) => venue.first_day).sort()[0]!;
---

<Layout
  title="Yleiskuva"
  heading="Kävijävirrat yhdellä silmäyksellä"
  description="Oulu2026: kahden venuen kävijämäärät, sää, liput ja seitsemän vuorokauden ennuste."
  lead={`Molempien venueiden viimeiset ${OVERVIEW_DAYS} vuorokautta ja seuraavat ${OVERVIEW_FORECAST_DAYS} vuorokautta rinnakkain. Havainnot alkavat ${formatDate(observedFrom)} ja ulottuvat ${formatDate(site.venues[0]!.last_day)} asti.`}
>
  <section aria-labelledby="avainluvut" class="mt-8">
    <h2 id="avainluvut" class="text-lg font-semibold tracking-tight text-ink">Avainluvut</h2>
    <p class="mt-1 max-w-3xl text-sm leading-6 text-ink-muted">
      Kaikki luvut ovat kävijätapahtumia: sisään- ja ulosmenojen summa, ei uniikkeja kävijöitä. Yksi
      käynti tuottaa tyypillisesti kaksi tapahtumaa.
    </p>

    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <StatCard
        label="Viimeiset 30 vrk, yhteensä"
        value={formatInt(totalLast30)}
        unit="kävijätapahtumaa"
        note="Molemmat venuet yhteensä."
      />
      {
        site.venues.map((venue) => (
          <StatCard
            label={`${venue.name}, 30 vrk keskiarvo`}
            value={formatInt(venue.last30.mean_daily)}
            unit="/ vrk"
            change={venue.change_pct === null ? undefined : formatSignedPct(venue.change_pct)}
            changeTone={
              venue.change_pct === null || Math.abs(venue.change_pct) < 1
                ? 'flat'
                : venue.change_pct > 0
                  ? 'up'
                  : 'down'
            }
            note={`Vertailu edeltäviin 30 vuorokauteen. Huippupäivä ${formatDate(venue.max_daily_date)}: ${formatInt(venue.max_daily)}.`}
          />
        ))
      }
      <StatCard
        label="Ennuste, seuraavat 7 vrk"
        value={formatInt(
          site.venues.reduce((acc, venue) => acc + (venue.next7?.p50 ?? 0), 0),
        )}
        unit="kävijätapahtumaa"
        note={`Mediaani, ${modelLabel(model)}. Epävarmuusväli näkyy kaavioissa alla.`}
      />
    </div>
  </section>

  <div class="mt-6 space-y-6">
    {
      panels.map(({ venue, window, forecastRows, history, forecastPoints, rain, holidays }) => (
        <Figure
          title={`${venue.name}: viimeiset ${OVERVIEW_DAYS} vrk ja seuraavat ${OVERVIEW_FORECAST_DAYS} vrk`}
          description={`Yhtenäinen viiva on toteuma, katkoviiva on mediaaniennuste mallilla ${modelLabel(model)} ja vaalea alue sen p10 - p90 -väli. Sinertävä tausta merkitsee vuorokauden jossa satoi vähintään ${RAINY_DAY_MM} mm.`}
          footnote={`Kapasiteetti ${formatInt(venue.capacity)} henkilöä. Aukiolo aineiston perusteella klo ${venue.open_hours[0]}-${venue.open_hours.at(-1)}.`}
        >
          <Timeseries
            client:visible
            ariaLabel={`Aikasarja: ${venue.name}, kävijätapahtumat vuorokaudessa viimeiset ${OVERVIEW_DAYS} vuorokautta ja ennuste seuraavat ${OVERVIEW_FORECAST_DAYS} vuorokautta.`}
            mode="day"
            history={history}
            forecast={forecastPoints}
            rain={rain}
            holidays={holidays}
            ranges={[{ label: `${OVERVIEW_DAYS} vrk`, days: OVERVIEW_DAYS }]}
            initialRange={OVERVIEW_DAYS}
          />

          <div slot="alternative">
            <p class="mb-3 text-xs leading-5 text-ink-muted">
              {`Jaksolla ${formatDate(window[0]?.date ?? venue.last_day)} - ${formatDate(venue.last_day)} kertyi ${visitorEvents(venue.last30.visitors_total)}, keskimäärin ${formatInt(venue.last30.mean_daily)} vuorokaudessa. Ennuste seuraaville seitsemälle vuorokaudelle on ${formatInt(venue.next7?.p50 ?? 0)} kävijätapahtumaa mediaanina.`}
            </p>
            <TableScroll label={`${venue.name}: toteuma ja ennuste vuorokausittain`}>
          <table class="data-table">
            <caption>{`${venue.name}: toteuma ja ennuste vuorokausittain`}</caption>
              <thead class="is-sticky">
                <tr>
                  <th scope="col">Päivä</th>
                  <th scope="col" class="num">Toteuma</th>
                  <th scope="col" class="num">Ennuste p50</th>
                  <th scope="col" class="num">p10 - p90</th>
                  <th scope="col">Huomiot</th>
                </tr>
              </thead>
              <tbody>
                {window.map((row) => (
                  <tr>
                    <th scope="row" class="nowrap">
                      {formatDateWithWeekday(row.date)}
                    </th>
                    <td class="num">{formatInt(row.visitors_total)}</td>
                    <td class="num muted">-</td>
                    <td class="num muted">-</td>
                    <td class="muted">
                      {[
                        row.is_holiday ? (row.holiday_name ?? 'pyhä') : null,
                        (row.precip_sum ?? 0) >= RAINY_DAY_MM ? 'sadetta' : null,
                        row.is_complete ? null : 'vajaa vuorokausi',
                      ]
                        .filter(Boolean)
                        .join(', ') || '-'}
                    </td>
                  </tr>
                ))}
                {forecastRows.map((row) => (
                  <tr class="is-forecast">
                    <th scope="row" class="nowrap">
                      {formatDateWithWeekday(row.date)}
                    </th>
                    <td class="num muted">-</td>
                    <td class="num">{formatInt(row.p50)}</td>
                    <td class="num">
                      {formatInt(row.p10)} - {formatInt(row.p90)}
                    </td>
                    <td class="muted">
                      {[
                        'ennuste',
                        row.is_holiday ? (row.holiday_name ?? 'pyhä') : null,
                        row.weather_source === 'climatology' ? 'sää klimatologiasta' : null,
                      ]
                        .filter(Boolean)
                        .join(', ')}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
        </TableScroll>
          </div>
        </Figure>
      ))
    }
  </div>

  <section aria-labelledby="tuoreus" class="mt-8">
    <h2 id="tuoreus" class="text-lg font-semibold tracking-tight text-ink">Datan tuoreus</h2>
    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        Object.entries(site.ingest.coverage).map(([name, entry]) => (
          <div class="rounded-lg border border-line bg-surface p-4 text-sm">
            <p class="font-medium text-ink">{name}</p>
            <p class="mt-1 text-xs leading-5 text-ink-muted">
              {formatDate(entry.first.slice(0, 10))} - {formatDate(entry.last.slice(0, 10))}
              <br />
              {entry.missing_hours === 0
                ? 'Ei puuttuvia tunteja.'
                : `${formatInt(entry.missing_hours)} puuttuvaa tuntia.`}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-4">
      {
        observationLagDays > 1 ? (
          <Callout tone="warning" title="Ennuste lähtee vanhentuneesta tasosta">
            <p>
              Viimeisin havaittu vuorokausi on {formatDate(site.venues[0]!.last_day)}, kun taas ennuste
              ajettiin {formatDate(forecastRunDate)}, eli {observationLagDays} vuorokautta myöhemmin.
              Ennuste alkaa havaintojen lopusta, ei tästä päivästä. Sama varoitus on kirjattu ennusteen
              manifestiin.
            </p>
          </Callout>
        ) : (
          <Callout title="Ennuste alkaa havaintojen lopusta">
            <p>
              Ennuste ajettiin {formatDate(forecastRunDate)} ja se lähtee vuorokaudesta
              {' '}{formatDate(site.venues[0]!.last_day)}, joka on viimeisin havaittu vuorokausi.
              Havainnot ja ennuste ovat siis samassa tahdissa.
            </p>
          </Callout>
        )
      }
    </div>
  </section>

  {
    site.traffic && (
      <section aria-labelledby="konteksti" class="mt-8">
        <h2 id="konteksti" class="text-lg font-semibold tracking-tight text-ink">
          Kontekstidata: kaupungin liikennelaskuri
        </h2>
        <Callout>
          <p>
            Oulun liikenteen laskuripiste <strong class="font-medium text-ink">{site.traffic.site_name}</strong> on
            yksi mittauspiste kaupungissa. Se ei liity kumpaankaan venueen eikä sitä yhdistetä
            venuekohtaiseksi kävijämittariksi. Se on mukana vain taustatietona kaupungin
            liikkumisesta.
          </p>
          <p class="mt-2">
            Jaksolla {formatDate(site.traffic.first_day)} - {formatDate(site.traffic.last_day)} laskuri
            kirjasi {formatInt(site.traffic.pedestrians)} jalankulkijaa ja{' '}
            {formatInt(site.traffic.cyclists)} pyöräilijää. Lisää{' '}
            <a class="underline" href="/weather">sääsivulla</a>.
          </p>
        </Callout>
      </section>
    )
  }
</Layout>
