---
/**
 * Datan laatu -banneri. Näkyy jokaisella sivulla ja kertoo viimeisen ajon ajan sekä
 * mahdolliset heikentyneet lähteet. Sävy vaihtuu sen mukaan onko jotain huomautettavaa.
 */
import meta from '../data/meta.json';
import type { Lang } from '../i18n/index.ts';
import { ui } from '../i18n/ui/index.ts';
import { formatters } from '../lib/format.ts';
import { localisedTexts, sourceLabel, sourceStatusLabel } from '../lib/labels.ts';
import type { Meta } from '../lib/types.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = meta as Meta;
const t = ui(lang);
const f = formatters(lang);

const degraded = site.ingest.degraded;
const ingestWarnings = localisedTexts(site.ingest.quality_gates.warnings, lang);
const forecastWarnings = localisedTexts(site.forecast.warnings, lang);
const skipped = site.forecast.skipped_models;

const hasIssue =
  degraded.length > 0 ||
  ingestWarnings.length > 0 ||
  forecastWarnings.length > 0 ||
  skipped.length > 0 ||
  !site.ingest.quality_gates.passed;

const tone = hasIssue
  ? 'border-b-amber-300 bg-amber-50 text-amber-950'
  : 'border-b-line bg-surface text-ink-muted';
---

<section aria-label={t.banner.region} class:list={['border-b', tone]}>
  <div class="mx-auto w-full max-w-6xl px-4 py-2.5 text-xs leading-5 sm:px-6">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <span
        aria-hidden="true"
        class:list={[
          'inline-block h-2 w-2 shrink-0 rounded-full',
          hasIssue ? 'bg-amber-500' : 'bg-emerald-600',
        ]}></span>
      <strong class="font-medium">{hasIssue ? t.banner.issues : t.banner.ok}</strong>
      <span>
        {t.banner.fetched(f.utc(site.ingest.generated_at), f.decimal(site.ingest.age_hours))}{' '}
        {t.banner.coverage(f.date(site.venues[0]!.last_day))}
      </span>
    </p>

    {
      hasIssue && (
        <ul class="mt-1.5 list-disc space-y-1 pl-5">
          {degraded.map((source) => (
            <li>
              {t.banner.source(sourceLabel(source.name, lang), sourceStatusLabel(source.status, lang))}
              {source.error ? `, ${source.error}` : ''}.
            </li>
          ))}
          {ingestWarnings.map((warning) => (
            <li>{warning}</li>
          ))}
          {forecastWarnings.map((warning) => (
            <li>{t.banner.forecastPrefix} {warning}</li>
          ))}
          {skipped.length > 0 && <li>{t.banner.skippedModels(skipped.join(', '))}</li>}
        </ul>
      )
    }
  </div>
</section>
