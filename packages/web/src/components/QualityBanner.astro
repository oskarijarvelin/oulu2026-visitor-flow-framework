---
/**
 * Datan laatu -banneri. Nakyy jokaisella sivulla ja kertoo viimeisen ajon ajan seka
 * mahdolliset heikentyneet lahteet. Sävy vaihtuu sen mukaan onko jotain huomautettavaa.
 */
import meta from '../data/meta.json';
import { formatDate, formatUtcAsHelsinki, formatDecimal } from '../lib/format.ts';
import { sourceLabel, sourceStatusLabel, translateWarnings } from '../lib/labels.ts';
import type { Meta } from '../lib/types.ts';

const site = meta as Meta;
const degraded = site.ingest.degraded;
const ingestWarnings = translateWarnings(site.ingest.quality_gates.warnings);
const forecastWarnings = translateWarnings(site.forecast.warnings);
const skipped = site.forecast.skipped_models;

const hasIssue =
  degraded.length > 0 ||
  ingestWarnings.length > 0 ||
  forecastWarnings.length > 0 ||
  skipped.length > 0 ||
  !site.ingest.quality_gates.passed;

const tone = hasIssue
  ? 'border-b-amber-300 bg-amber-50 text-amber-950'
  : 'border-b-line bg-surface text-ink-muted';
---

<section aria-label="Datan laatu" class:list={['border-b', tone]}>
  <div class="mx-auto w-full max-w-6xl px-4 py-2.5 text-xs leading-5 sm:px-6">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <span
        aria-hidden="true"
        class:list={[
          'inline-block h-2 w-2 shrink-0 rounded-full',
          hasIssue ? 'bg-amber-500' : 'bg-emerald-600',
        ]}></span>
      <strong class="font-medium">
        {hasIssue ? 'Datan laadussa huomautettavaa' : 'Data on ajan tasalla'}
      </strong>
      <span>
        Viimeisin haku {formatUtcAsHelsinki(site.ingest.generated_at)}, {formatDecimal(site.ingest.age_hours)} tuntia
        sitten. Havainnot ulottuvat {formatDate(site.venues[0]!.last_day)} asti.
      </span>
    </p>

    {
      hasIssue && (
        <ul class="mt-1.5 list-disc space-y-1 pl-5">
          {degraded.map((source) => (
            <li>
              Lähde {sourceLabel(source.name)}: {sourceStatusLabel(source.status)}
              {source.error ? `, ${source.error}` : ''}.
            </li>
          ))}
          {ingestWarnings.map((warning) => (
            <li>{warning}</li>
          ))}
          {forecastWarnings.map((warning) => (
            <li>Ennuste: {warning}</li>
          ))}
          {skipped.length > 0 && <li>Ohitetut mallit: {skipped.join(', ')}.</li>}
        </ul>
      )
    }
  </div>
</section>
