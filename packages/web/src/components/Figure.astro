---
/**
 * Kaaviokortti. Kaavio itse on saareke joka latautuu vasta nakyviin tullessaan;
 * otsikko, kuvaus ja tekstivastine renderoidaan palvelimella, joten kortti on
 * ymmarrettava myos ilman JavaScriptia.
 */

import type { Lang } from '../i18n/index.ts';
import { ui } from '../i18n/ui/index.ts';

interface Props {
  lang: Lang;
  title: string;
  /** Lyhyt selitys siita mita kaavio esittaa. */
  description?: string;
  /** Kaavion alle tuleva huomautus, esimerkiksi tulkintavaroitus. */
  footnote?: string;
  /** Otsikkotaso, oletuksena h2. */
  level?: 2 | 3;
  id?: string;
}

const { lang, title, description, footnote, level = 2, id } = Astro.props;
const t = ui(lang);
const Heading = `h${level}` as 'h2' | 'h3';
const hasAlternative = Astro.slots.has('alternative');
---

<section
  id={id}
  class="rounded-lg border border-line bg-surface p-4 shadow-[0_1px_2px_rgba(20,23,31,0.04)] sm:p-5"
>
  <Heading class:list={[level === 2 ? 'text-lg' : 'text-base', 'font-semibold tracking-tight text-ink']}>
    {title}
  </Heading>
  {description && <p class="mt-1 max-w-3xl text-sm leading-6 text-ink-muted">{description}</p>}

  <div class="mt-4">
    <slot />
  </div>

  {footnote && <p class="mt-3 text-xs leading-5 text-ink-muted">{footnote}</p>}

  {
    hasAlternative && (
      <details class="group mt-3 border-t border-line pt-3">
        <summary class="cursor-pointer text-xs font-medium text-ink-muted hover:text-ink">
          {t.common.textAlternative}
        </summary>
        <div class="mt-3">
          <slot name="alternative" />
        </div>
      </details>
    )
  }
</section>
