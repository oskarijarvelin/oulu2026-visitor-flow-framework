---
import meta from '../data/meta.json';
import { canonicalPath, localizedPath, type Lang } from '../i18n/index.ts';
import { ui } from '../i18n/ui/index.ts';
import type { Meta } from '../lib/types.ts';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const site = meta as Meta;
const t = ui(lang);
const current = canonicalPath(pathname);

const links: { href: string; label: string }[] = [
  { href: '/', label: t.nav.overview },
  ...site.venues.map((venue) => ({ href: `/venue/${venue.venue_id}`, label: venue.name })),
  { href: '/weather', label: t.nav.weather },
  { href: '/forecast', label: t.nav.forecast },
  { href: '/quality', label: t.nav.quality },
  { href: '/about', label: t.nav.about },
];
---

<div class="mt-3 flex items-center gap-3">
  <nav aria-label={t.nav.label} class="-mx-4 min-w-0 flex-1 overflow-x-auto px-4 sm:mx-0 sm:px-0">
    <ul class="flex min-w-max items-center gap-1 pb-1">
      {
        links.map((link) => {
          const active = current === link.href;
          return (
            <li>
              <a
                href={localizedPath(link.href, lang)}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'block rounded-md px-3 py-1.5 text-sm no-underline transition-colors',
                  active
                    ? 'bg-series-1 font-medium text-white'
                    : 'text-ink-muted hover:bg-canvas hover:text-ink',
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
  <LanguageSwitch lang={lang} pathname={pathname} />
</div>
